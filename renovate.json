{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "Asia/Kolkata",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "7 days",
  "osvVulnerabilityAlerts": true,
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "lockFileMaintenance": { "enabled": true, "automerge": true, "minimumReleaseAge": null },
  "packageRules": [
    {
      "description": "Everything short of a major merges itself once verify and image pass.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "automerge": true
    },
    {
      "description": "A 0.x minor is a major by another name.",
      "matchCurrentVersion": "/^0\\./",
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },
    {
      "description": "Docker Hub dates a tag by its last push and a digest not at all, so an age would hold images forever.",
      "matchDatasources": ["docker"],
      "minimumReleaseAge": null
    },
    {
      "description": "Node moves as one: the Dockerfile's image, the workflows' node-version, and its types.",
      "matchDepNames": ["node", "@types/node"],
      "groupName": "node"
    }
  ]
}
