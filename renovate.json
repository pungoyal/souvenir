{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "customManagers:biomeVersions"],
  "timezone": "Asia/Kolkata",
  "schedule": ["before 6am on monday"],
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": { "automerge": true },
  "packageRules": [
    {
      "description": "A release is a week old before it is proposed.",
      "matchPackageNames": ["*"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Docker Hub gives digests no date, so an age would hold images forever.",
      "matchDatasources": ["docker"],
      "minimumReleaseAge": null
    },
    {
      "description": "A Node major moves as one PR.",
      "matchDepNames": ["node", "@types/node"],
      "matchUpdateTypes": ["major"],
      "groupName": "node"
    },
    {
      "description": "Everything short of a major is one weekly PR that merges itself.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "groupName": "everything short of a major",
      "automerge": true
    },
    {
      "description": "A 0.x minor can break: its own PR, for a person.",
      "matchCurrentVersion": "/^0\\./",
      "matchUpdateTypes": ["minor"],
      "groupName": null,
      "automerge": false
    },
    {
      "description": "A new Biome can fail verify until `pnpm format` is run, so it must not hold the weekly PR back.",
      "matchPackageNames": ["@biomejs/biome"],
      "groupName": null
    }
  ]
}
