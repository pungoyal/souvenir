# Copy to .env. Validated in lib/env.ts; a blank value is unset.

# Host ports and bind address for docker compose. DATABASE_URL's port must equal DB_PORT.
DB_PORT=5566
APP_PORT=3004
APP_BIND=127.0.0.1
DATABASE_URL=postgres://souvenir:souvenir@127.0.0.1:5566/souvenir
POSTGRES_PASSWORD=souvenir
# The reverse proxy's docker network; must already exist.
DOCKER_NETWORK=edge

# Required, 16+ chars: `openssl rand -base64 32`. Rotating it signs everyone out.
AUTH_SECRET=
# Use localhost, not 127.0.0.1: an IP is not a valid passkey rp id.
AUTH_URL=http://localhost:3000
# Redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Passwordless fake login; never true in production.
AUTH_DEV_LOGIN=false

# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info
RANKED_MIN_RESOLVED=5
# Shown on /privacy.
# CONTACT_EMAIL=you@example.com

# Optional: any Anthropic-compatible API.
LLM_BASE_URL=https://api.minimax.io/anthropic
LLM_API_KEY=
LLM_MODEL=MiniMax-M3

# Optional server voice for /talk: MiniMax's /v1/t2a_v2 (https://api.minimax.io).
SPEECH_BASE_URL=
SPEECH_API_KEY=
SPEECH_TTS_MODEL=speech-2.6-turbo
SPEECH_GROUP_ID=
# One voice per language code, comma-separated, then a fallback per side. PITCH is semitones
# (-12 to 12). Check with `pnpm speech:check`.
SPEECH_VOICES=th=Thai_male_1_sample8
SPEECH_VOICE_US=hindi_female_1_v2
SPEECH_VOICE_THEM=
SPEECH_VOICE_THEM_PITCH=-5
SPEECH_VOICE_THEM_SPEED=0.9

# Any host serving currency-api's /v1/currencies/{code}.min.json.
# FX_BASE_URL=https://latest.currency-api.pages.dev
